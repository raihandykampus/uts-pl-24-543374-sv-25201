        {
          "name": "Get Current User Profile (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns authenticated user details\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.user).to.have.property(\"email\");",
                  "    pm.expect(json.user.email).to.eql(\"test@example.com\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
