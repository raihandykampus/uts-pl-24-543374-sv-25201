{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
    "name": "Task Tracker API",
    "description": "Postman Collection v2.1 untuk pengujian REST API Task Tracker UTS. Seluruh endpoint selain login wajib dan telah diverifikasi terlindungi oleh Sanctum Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
